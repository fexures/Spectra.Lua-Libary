    self.Bg.BorderSizePixel = 0
    self.Bg.Parent = self.Container
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 2)
    bgCorner.Parent = self.Bg

    self.Fill = Instance.new("Frame")
    self.Fill.Size = UDim2.new((self.Value - self.Min) / self.Range, 0, 1, 0)
    self.Fill.BackgroundColor3 = self.Theme.Accent
    self.Fill.BorderSizePixel = 0
    self.Fill.Parent = self.Bg
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 2)
    fillCorner.Parent = self.Fill

    self.Handle = Instance.new("Frame")
    self.Handle.Size = UDim2.new(0, 14, 0, 14)
    self.Handle.Position = UDim2.new((self.Value - self.Min) / self.Range, -7, 0.5, -7)
    self.Handle.BackgroundColor3 = self.Theme.Accent
    self.Handle.BorderSizePixel = 0
    self.Handle.Parent = self.Bg
    local handleCorner = Instance.new("UICorner")
    handleCorner.CornerRadius = UDim.new(0, 7)
    handleCorner.Parent = self.Handle
    local handleStroke = Instance.new("UIStroke")
    handleStroke.Color = Color3.fromRGB(255, 255, 255)
    handleStroke.Thickness = 2
    handleStroke.Transparency = 0.3
    handleStroke.Parent = self.Handle

    self:AddConnection(self.Bg.InputBegan:Connect(function(input)
        if self.Destroyed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.Dragging = true
            InputManager.ActiveSliders[self] = self
            self:Update(input)
        end
    end))
    return self
end

function Slider:UpdateTheme(theme)
    if self.Destroyed then return end
    self.Theme = theme
    self.Label.TextColor3 = self.Theme.Text
    self.ValueLabel.TextColor3 = self.Theme.Accent
    self.Fill.BackgroundColor3 = self.Theme.Accent
    self.Handle.BackgroundColor3 = self.Theme.Accent
end

function Slider:OnChanged(callback) 
    self.Callback = callback 
end

function Slider:Update(input)
    if self.Destroyed then return end
    local relativeX = (input.Position.X - self.Bg.AbsolutePosition.X) / self.Bg.AbsoluteSize.X
    relativeX = Utils.Clamp(relativeX, 0, 1)
    self.Value = self.Min + self.Range * relativeX
    self.Value = Utils.Round(self.Value)
    self.Fill.Size = UDim2.new(relativeX, 0, 1, 0)
    self.Handle.Position = UDim2.new(relativeX, -7, 0.5, -7)
    self.ValueLabel.Text = tostring(self.Value) .. self.Suffix
    pcall(self.Callback, self.Value)
end

function Slider:SetValue(value)
    if self.Destroyed then return end
    self.Value = Utils.Clamp(value, self.Min, self.Max)
    local relativeX = (self.Value - self.Min) / self.Range
    self.Fill.Size = UDim2.new(relativeX, 0, 1, 0)
    self.Handle.Position = UDim2.new(relativeX, -7, 0.5, -7)
    self.ValueLabel.Text = tostring(self.Value) .. self.Suffix
    pcall(self.Callback, self.Value)
end

function Slider:GetValue() 
    return self.Value 
end

function Slider:GetName() 
    return self.NameText 
end

function Slider:Destroy()
    if self.Destroyed then return end
    InputManager.ActiveSliders[self] = nil
    Component.Destroy(self)
end

