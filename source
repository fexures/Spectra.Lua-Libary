local Dropdown = setmetatable({}, Component)
Dropdown.__index = Dropdown
Dropdown.Class = "Dropdown"

function Dropdown.new(parent, config, theme)
    local self = setmetatable(Component.new(theme), Dropdown)
    self.Parent = parent
    self.Options = config.Options or {}
    self.Selected = config.Default or (config.Options and config.Options[1]) or ""
    self.Callback = config.Callback or function() end
    self.Open = false
    self.NameText = config.Text or config.Name or "Dropdown"
    self.Saveable = true
    self.Overlay = GetDropdownOverlay()
    table.insert(ActiveDropdowns, self)

    if config.Flag then
        self.Flag = config.Flag
        local library = FindLibrary(parent)
        if library then
            library.Flags[config.Flag] = self
        end
    end

    self.Container = Instance.new("Frame")
    self.Container.Size = UDim2.new(1, 0, 0, 30)
    self.Container.BackgroundTransparency = 1
    self.Container.Parent = parent

    self.Label = Instance.new("TextLabel")
    self.Label.Size = UDim2.new(0.4, 0, 1, 0)
    self.Label.Position = UDim2.new(0, 4, 0, 0)
    self.Label.BackgroundTransparency = 1
    self.Label.Text = self.NameText
    self.Label.TextColor3 = self.Theme.Text
    self.Label.TextSize = 13
    self.Label.Font = Enum.Font.SourceSans
    self.Label.TextXAlignment = Enum.TextXAlignment.Left
    self.Label.TextYAlignment = Enum.TextYAlignment.Center
    self.Label.Parent = self.Container

    self.MainBtn = Instance.new("TextButton")
    self.MainBtn.Size = UDim2.new(0.6, -8, 1, 0)
    self.MainBtn.Position = UDim2.new(0.4, 4, 0, 0)
    self.MainBtn.BackgroundColor3 = self.Theme.Secondary
    self.MainBtn.BackgroundTransparency = 0.2
    self.MainBtn.BorderSizePixel = 0
    self.MainBtn.Text = self.Selected
    self.MainBtn.TextColor3 = self.Theme.Text
    self.MainBtn.TextSize = 13
    self.MainBtn.Font = Enum.Font.SourceSans
    self.MainBtn.Parent = self.Container
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = self.MainBtn

    self.DropdownList = Instance.new("Frame")
    self.DropdownList.Size = UDim2.new(0.6, -8, 0, 0)
    self.DropdownList.Position = UDim2.new(0.4, 4, 0, 30)
    self.DropdownList.BackgroundColor3 = self.Theme.Secondary
    self.DropdownList.BackgroundTransparency = 0.15
    self.DropdownList.BorderSizePixel = 0
    self.DropdownList.ClipsDescendants = true
    self.DropdownList.Parent = self.Container
    self.DropdownList.Visible = false
    local dropCorner = Instance.new("UICorner")
    dropCorner.CornerRadius = UDim.new(0, 4)
    dropCorner.Parent = self.DropdownList
    local dropStroke = Instance.new("UIStroke")
    dropStroke.Color = self.Theme.Border
    dropStroke.Thickness = 1
    dropStroke.Transparency = 0.5
    dropStroke.Parent = self.DropdownList

    self.DropdownLayout = Instance.new("UIListLayout")
    self.DropdownLayout.Padding = UDim.new(0, 2)
    self.DropdownLayout.FillDirection = Enum.FillDirection.Vertical
    self.DropdownLayout.SortOrder = Enum.SortOrder.LayoutOrder
    self.DropdownLayout.Parent = self.DropdownList

    self.OptionButtons = {}
    for _, option in ipairs(self.Options) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 26)
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel = 0
        btn.Text = option
        btn.TextColor3 = self.Theme.Text
        btn.TextSize = 13
        btn.Font = Enum.Font.SourceSans
        btn.Parent = self.DropdownList

        self:AddConnection(btn.MouseEnter:Connect(function()
            if self.Destroyed then return end
            btn.BackgroundTransparency = 0.05
            btn.BackgroundColor3 = self.Theme.Accent
        end))

        self:AddConnection(btn.MouseLeave:Connect(function()
            if self.Destroyed then return end
            btn.BackgroundTransparency = 1
        end))

        self:AddConnection(btn.MouseButton1Click:Connect(function()
            if self.Destroyed then return end
            self:Select(option)
        end))

        table.insert(self.OptionButtons, btn)
    end

    self:AddConnection(self.MainBtn.MouseButton1Click:Connect(function()
        if self.Destroyed then return end
        self:Toggle()
    end))
    return self
end

function Dropdown:UpdateTheme(theme)
    if self.Destroyed then return end
    self.Theme = theme
    self.Label.TextColor3 = self.Theme.Text
    self.MainBtn.BackgroundColor3 = self.Theme.Secondary
    self.MainBtn.TextColor3 = self.Theme.Text
    self.DropdownList.BackgroundColor3 = self.Theme.Secondary
    for _, btn in ipairs(self.OptionButtons) do
        btn.TextColor3 = self.Theme.Text
    end
end

function Dropdown:OnChanged(callback) 
    self.Callback = callback 
end

function Dropdown:Toggle()
    if self.Destroyed then return end
    self.Open = not self.Open
    if self.Open then
        self.DropdownList.Visible = true
        local height = #self.Options * 28 + 4
        self.DropdownList.Size = UDim2.new(0.6, -8, 0, 0)
        Utils.Tween(self.DropdownList, {Size = UDim2.new(0.6, -8, 0, height)}, 0.15)
    else
        self:Close()
    end
end

function Dropdown:Close()
    if self.Destroyed then return end
    self.Open = false
    Utils.Tween(self.DropdownList, {Size = UDim2.new(0.6, -8, 0, 0)}, 0.1)
    task.wait(0.1)
    self.DropdownList.Visible = false
end

function Dropdown:Select(option)
    if self.Destroyed then return end
    self.Selected = option
    self.MainBtn.Text = option
    pcall(self.Callback, option)
    self:Close()
end

function Dropdown:GetValue() 
    return self.Selected 
end

function Dropdown:SetValue(value) 
    self:Select(value) 
end

function Dropdown:GetName() 
    return self.NameText 
end

function Dropdown:Destroy()
    if self.Destroyed then return end
    for i, v in pairs(ActiveDropdowns) do
        if v == self then table.remove(ActiveDropdowns, i) end
    end
    Component.Destroy(self)
end

