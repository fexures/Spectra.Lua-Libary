    if self.Destroyed then return end
    self.Key = Enum.KeyCode[data.Key] or Enum.KeyCode.None
    self.KeyType = data.Type or "KeyCode"
    self.Mode = data.Mode or "Toggle"
    self.KeyBtn.Text = Utils.GetKeyName(self.Key)
end

function Keybind:GetName() 
    return self.NameText 
end

function Keybind:Destroy()
    if self.Destroyed then return end
    for i, v in pairs(InputManager.ActiveKeybinds) do
        if v == self then
            table.remove(InputManager.ActiveKeybinds, i)
        end
    end
    Component.Destroy(self)
end

