    self.Callback = callback 
end

function Keybind:StartListening()
    if self.Destroyed then return end
    self.Waiting = true
    self.KeyBtn.Text = "..."
    self.KeyBtn.TextColor3 = self.Theme.Accent
end

function Keybind:SetKey(input)
    if self.Destroyed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard or
       input.UserInputType == Enum.UserInputType.MouseButton1 or
       input.UserInputType == Enum.UserInputType.MouseButton2 or
       input.UserInputType == Enum.UserInputType.MouseButton3 then
        self.Key = input.KeyCode
        self.KeyType = "KeyCode"
        self.KeyBtn.Text = Utils.GetKeyName(self.Key)
        pcall(self.Callback, self.Key)
    else
        self.Key = Enum.KeyCode.None
        self.KeyType = "KeyCode"
        self.KeyBtn.Text = "None"
        pcall(self.Callback, nil)
    end

    self.Waiting = false
    self.KeyBtn.TextColor3 = self.Theme.Text
end

function Keybind:GetKey() 
    return self.Key, self.KeyType 
end

