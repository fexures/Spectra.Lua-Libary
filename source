function WindowClass:ProcessNotificationQueue()
    if self.NotificationActive or #self.NotificationQueue == 0 or self.IsDestroyed then return end

    self.NotificationActive = true
    local notif = table.remove(self.NotificationQueue, 1)

    local container = notif.Container
    container.Visible = true
    container.Position = UDim2.new(0.5, -160, 1, 0)

    Utils.Tween(container, {Position = UDim2.new(0.5, -160, 1, -60)}, 0.3)
    task.wait(notif.Duration)
    Utils.Tween(container, {Position = UDim2.new(0.5, -160, 1, 0)}, 0.3)
    task.wait(0.3)

    self:RemoveObject(container)
    container:Destroy()

    self.NotificationActive = false
    self:ProcessNotificationQueue()
end

