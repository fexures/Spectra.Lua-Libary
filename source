function WindowClass:Open()
    if self.IsOpen or self.IsDestroyed then return end
    if not self.Gui or not self.Main then return end

    self.Gui.Enabled = true
    self.Main.Size = UDim2.new(0, 0, 0, 0)
    Utils.Tween(self.Main, {Size = self.WindowSize}, 0.3)
    self.IsOpen = true
end

function WindowClass:Close()
    if not self.IsOpen or self.IsDestroyed then return end
    if not self.Gui or not self.Main then return end

    local tween = Utils.Tween(self.Main, {Size = UDim2.new(0, 0, 0, 0)}, 0.2)
    tween.Completed:Wait()
    self.Gui.Enabled = false
    self.Main.Size = UDim2.new(0, 0, 0, 0)
    self.IsOpen = false
end

function WindowClass:Toggle()
    if self.IsDestroyed then return end
    if self.IsOpen then self:Close() else self:Open() end
end

function WindowClass:SaveConfig(name)
    if self.IsDestroyed then return end
    name = name or "default"
    local config = {}

    for tabName, tab in pairs(self.Tabs) do
        config[tabName] = {}
        for _, component in ipairs(tab.Components) do
            if component.Saveable and component.GetValue then
                table.insert(config[tabName], {
                    Flag = component:GetFlag(),
                    ID = component.ID,
                    Name = component:GetName(),
                    Type = component:GetType(),
                    Class = component.Class,
                    Version = component.Version or 1,
                    Value = component:GetValue()
                })
            end
        end
    end

    return HttpService:JSONEncode(config)
end

function WindowClass:SaveToFile(name)
    if self.IsDestroyed then return end
    if writefile then
        local json = self:SaveConfig(name)
        writefile("SpectraConfig_" .. name .. ".json", json)
        self:Notify({Title = "💾 Config Saved!", Lifetime = 2})
    else
        self:Notify({Title = "❌ writefile not available!", Type = "error", Lifetime = 2})
    end
end

function WindowClass:LoadFromFile(name)
    if self.IsDestroyed then return end
    if readfile then
        local json = readfile("SpectraConfig_" .. name .. ".json")
        if json and json ~= "" then
            local config = HttpService:JSONDecode(json)
            for tabName, tabData in pairs(config) do
                if self.Tabs[tabName] then
                    local tab = self.Tabs[tabName]
                    for _, compData in ipairs(tabData) do
                        for _, component in ipairs(tab.Components) do
                            local match = false
                            if compData.Flag and component:GetFlag() == compData.Flag then
                                match = true
                            elseif compData.ID and component.ID == compData.ID then
                                match = true
                            elseif compData.Name and component:GetName() == compData.Name then
                                match = true
                            end

                            if match and component.SetValue then
                                component:SetValue(compData.Value)
                                break
                            end
                        end
                    end
                end
            end
            self:Notify({Title = "📂 Config Loaded!", Lifetime = 2})
        else
            self:Notify({Title = "❌ Config not found!", Type = "error", Lifetime = 2})
        end
    else
        self:Notify({Title = "❌ readfile not available!", Type = "error", Lifetime = 2})
    end
end

function WindowClass:Destroy()
    if self.IsDestroyed then return end
    self.IsDestroyed = true

    for _, conn in pairs(self.WindowConnections) do
        conn:Disconnect()
    end
    self.WindowConnections = {}

    if self.Objects then
        for _, obj in pairs(self.Objects) do
            if obj and obj.Destroy then
                pcall(obj.Destroy, obj)
            end
        end
    end

    if self.Gui then
        self.Gui:Destroy()
        self.Gui = nil
    end

    self.IsOpen = false
end

function SpectraLibrary.new()
    local self = setmetatable({}, SpectraLibrary)
    self.ToggleKey = Enum.KeyCode.RightShift
    self.CoreConnections = {}
    self.Windows = {}

    local conn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == self.ToggleKey then
            for _, window in pairs(self.Windows or {}) do
                if window and not window.IsDestroyed then
                    window:Toggle()
                end
            end
        end
    end)
    table.insert(self.CoreConnections, conn)

    return self
end

function SpectraLibrary:SetToggleKey(key)
    self.ToggleKey = key
end

function SpectraLibrary:CreateWindow(config)
    local window = WindowClass.new(self)
    window:CreateWindow(config)
    if not self.Windows then
        self.Windows = {}
    end
    table.insert(self.Windows, window)
    return window
end

function SpectraLibrary:Destroy()
    for _, conn in pairs(self.CoreConnections) do
        conn:Disconnect()
    end
    self.CoreConnections = {}

    for _, window in pairs(self.Windows or {}) do
        if window and not window.IsDestroyed then
            window:Destroy()
        end
    end
    self.Windows = {}
end

local InputManager = {
    ActiveSliders = {},
    ActiveKeybinds = {},
}

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        for _, slider in pairs(InputManager.ActiveSliders) do
            if slider and slider.Dragging then
                slider:Update(input)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        for _, slider in pairs(InputManager.ActiveSliders) do
            if slider then
                slider.Dragging = false
            end
        end
        InputManager.ActiveSliders = {}
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    for _, keybind in pairs(InputManager.ActiveKeybinds) do
        if keybind and keybind.Waiting then
            if input.UserInputType == Enum.UserInputType.Keyboard or
               input.UserInputType == Enum.UserInputType.MouseButton1 or
               input.UserInputType == Enum.UserInputType.MouseButton2 or
               input.UserInputType == Enum.UserInputType.MouseButton3 then
                keybind:SetKey(input)
            end
            continue
        end

        if keybind and keybind.Key ~= Enum.KeyCode.None then
            if keybind.KeyType == "KeyCode" then
                if input.KeyCode == keybind.Key then
                    pcall(keybind.Callback, keybind.Key)
                end
            elseif keybind.KeyType == "UserInputType" then
                if input.UserInputType == keybind.Key then
                    pcall(keybind.Callback, keybind.Key)
                end
            end
        end
    end
end)

return SpectraLibrary
