function Toggle:SetState(state, animate)
    if self.Destroyed then return end
    self.State = state
    animate = (animate ~= false)
    local bgColor = self.State and self.Theme.Accent or Color3.fromRGB(40, 40, 60)
    local circlePos = self.State and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    local labelColor = self.State and Color3.fromRGB(255, 255, 255) or self.Theme.Text

    if animate then
        Utils.Tween(self.SwitchBg, {BackgroundColor3 = bgColor})
        Utils.Tween(self.Circle, {Position = circlePos})
        Utils.Tween(self.Label, {TextColor3 = labelColor})
    else
        self.SwitchBg.BackgroundColor3 = bgColor
        self.Circle.Position = circlePos
        self.Label.TextColor3 = labelColor
    end
    pcall(self.Callback, self.State)
end

function Toggle:Toggle() 
    self:SetState(not self.State) 
end

function Toggle:GetState() 
    return self.State 
end

function Toggle:GetValue() 
    return self.State 
end

function Toggle:SetValue(value) 
    self:SetState(value, false) 
end

function Toggle:GetName() 
    return self.NameText 
end

function Toggle:Destroy()
    if self.Destroyed then return end
    Component.Destroy(self)
end

