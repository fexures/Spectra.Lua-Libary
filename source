function WindowClass:SetupDragging()
    local dragging = false
    local dragStart = nil
    local frameStart = nil

    local conn1 = self.TitleFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            frameStart = self.Main.Position
        end
    end)
    self:AddWindowConnection(conn1)

    local conn2 = self.TitleFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    self:AddWindowConnection(conn2)

    local conn3 = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local delta = input.Position - dragStart
        self.Main.Position = UDim2.new(
            frameStart.X.Scale,
            frameStart.X.Offset + delta.X,
            frameStart.Y.Scale,
            frameStart.Y.Offset + delta.Y
        )
    end)
    self:AddWindowConnection(conn3)
end

