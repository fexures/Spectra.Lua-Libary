function WindowClass.new(library)
    local self = setmetatable({}, WindowClass)
    self.Library = library
    self.Theme = Utils.DeepCopy(DefaultColors)
    self.Flags = {}
    self.Gui = nil
    self.Main = nil
    self.TitleFrame = nil
    self.LeftPanel = nil
    self.RightPanel = nil
    self.Tabs = {}
    self.TabsList = {}
    self.Objects = {}
    self.WindowConnections = {}
    self.Notifications = {}
    self.WindowSize = nil
    self.PreviousSize = nil
    self.IsOpen = false
    self.IsDestroyed = false
    self.NotificationQueue = {}
    self.NotificationActive = false
    return self
end

function WindowClass:AddObject(obj)
    table.insert(self.Objects, obj)
    return obj
end

function WindowClass:RemoveObject(obj)
    for i, v in pairs(self.Objects) do
        if v == obj then
            table.remove(self.Objects, i)
            return
        end
    end
end

function WindowClass:AddWindowConnection(connection)
    table.insert(self.WindowConnections, connection)
    return connection
end

function WindowClass:SetTheme(name)
    if not Themes[name] then
        self:Notify({Title = "❌ Theme '" .. name .. "' not found!", Type = "error", Lifetime = 2})
        return
    end
    local theme = Themes[name]
    for key, value in pairs(theme) do
        self.Theme[key] = value
    end

    for _, tab in pairs(self.Tabs) do
        if tab.UpdateTheme then
            tab:UpdateTheme(self.Theme)
        end
    end

    self:Notify({Title = "🎨 Theme '" .. name .. "' applied!", Lifetime = 2})
end

function WindowClass:CreateTheme(name, colors)
    Themes[name] = {}
    for key, value in pairs(DefaultColors) do
        Themes[name][key] = colors[key] or value
    end
end

function WindowClass:CreateWindow(config)
    if self.IsDestroyed then return end

    if self.Gui then
        self.Gui:Destroy()
        self.Gui = nil
    end

    for _, conn in pairs(self.WindowConnections) do
        conn:Disconnect()
    end
    self.WindowConnections = {}

    self.Tabs = {}
    self.TabsList = {}
    self.Objects = {}
    self.Notifications = {}
    self.Flags = {}

    config = config or {}
    local title = config.Title or "SPECTRA"
    local subtitle = config.SubText or "UI Library"
    local size = config.Size or UDim2.new(0, 540, 0, 420)
    self.WindowSize = size
    self.PreviousSize = size
    self.TitleText = title
    self.SubText = subtitle

    self.Gui = Instance.new("ScreenGui")
