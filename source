end

function Component:GetType()
    return self.Class
end

function Component:GetName()
    return "Component"
end

function Component:UpdateTheme(theme)
    self.Theme = theme
end

local function FindLibrary(parent)
    local current = parent
    while current do
        if current.Library then
            return current.Library
        end
        current = current.Parent
    end
    return nil
end

local DropdownOverlay = nil
local ActiveDropdowns = {}

local function GetDropdownOverlay()
    if not DropdownOverlay then
        DropdownOverlay = Instance.new("Frame")
        DropdownOverlay.Size = UDim2.new(1, 0, 1, 0)
        DropdownOverlay.BackgroundTransparency = 1
        DropdownOverlay.Parent = CoreGui
        DropdownOverlay.Visible = false
        DropdownOverlay.ZIndex = 100
        DropdownOverlay.Name = "SpectraDropdownOverlay"

        DropdownOverlay.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                for _, dropdown in pairs(ActiveDropdowns) do
                    if dropdown and dropdown.Open then
                        dropdown:Close()
                    end
                end
            end
        end)
    end
    return DropdownOverlay
end

