}

function Utils.GetKeyName(key)
    if Keys[key] then
        return Keys[key]
    end
    local name = tostring(key)
    name = string.gsub(name, "Enum.KeyCode.", "")
    name = string.gsub(name, "Enum.UserInputType.", "")
    return name
end

local Component = {}
Component.__index = Component

function Component.new(theme)
    local self = setmetatable({}, Component)
    self.Theme = theme or DefaultColors
    self.ID = Utils.GenerateID()
    self.Destroyed = false
    self.Connections = {}
    self.Saveable = true
    self.Flag = nil
    self.Class = "Component"
    self.Version = 1
    return self
end

function Component:AddConnection(connection)
    table.insert(self.Connections, connection)
    return connection
end

function Component:DisconnectAll()
    for _, conn in pairs(self.Connections) do
        conn:Disconnect()
    end
    self.Connections = {}
end

function Component:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    self:DisconnectAll()
    if self.Container then
        self.Container:Destroy()
    end
end

function Component:SetFlag(flag)
    self.Flag = flag
    if flag and self.Parent and self.Parent.Library then
        self.Parent.Library.Flags[flag] = self
    end
end

function Component:GetFlag()
    return self.Flag
end

function Component:GetValue()
    return nil
end

